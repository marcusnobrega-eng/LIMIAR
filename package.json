{
  "name": "limiar-atlas",
  "version": "1.0.0",
  "private": true,
  "description": "Static public atlas for reconstructed flood signals in Brazil",
  "scripts": {
    "lint": "npm run lint:biome && npm run lint:deps && npm run lint:arch",
    "lint:biome": "biome lint app.js observability.js",
    "lint:deps": "knip",
    "lint:arch": "arch-contract check --config arch-contract.yaml",
    "lint:commits": "commitlint --from origin/main --to HEAD --verbose"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "arch-contract": "0.3.0",
    "knip": "6.34.0"
  },
  "engines": {
    "node": ">=22"
  }
}
